# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API.
# Without these, the app runs in demo mode (try /toluadire).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Supabase key (Project Settings -> API -> service_role). NEVER share it or
# put it in a NEXT_PUBLIC_ variable. Needed for checkout, orders and escrow.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack secret key (Paystack dashboard -> Settings -> API Keys & Webhooks).
# Use the TEST key (sk_test_...) until you have legal sign-off to take real money.
PAYSTACK_SECRET_KEY=sk_test_your_key

# Any long random string. Protects the daily auto-release job.
CRON_SECRET=change-me-to-a-long-random-string

# Any long random string (16+ characters). Used to build buyers' private order links,
# so WhatsApp messages can include them. Don't change it after launch, or old links stop working.
ORDER_LINK_SECRET=change-me-to-another-long-random-string

# WhatsApp Business Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup).
# Leave empty to turn WhatsApp messages off. See docs/whatsapp-templates.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=any-random-string-you-also-type-into-meta
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en

# The address the app runs on (used in sign-in emails and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
